{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
            "Microsoft.AspNetCore.Routing": "Warning"
        },
        "Console": {
            "LogLevel": {
                "Default": "Information",
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "WebApi": {
        "Hosts": ["http://localhost:7297"]
    },
    "Cors": {
        "AllowedOrigins": [
            "https://switchyard.top",
            "http://switchyard.top",
            "https://kapparail.com",
            "https://www.kapparail.com",
            "https://api.kapparail.com",
            "https://api.kapparail.com:8080",
            "http://localhost:4173",
            "https://localhost:4173",
            "http://127.0.0.1:4173"
        ]
    },
    "Course": {
        "VideoDir": "/data/switchyardvid",
        "DocDir": "/data/switchyardvid"
    },
    "Jwt": {
        "_comment": "SecretKey 必须通过环境变量 Jwt__SecretKey 注入（见 scripts/deploy/switchyard-api.env.example），切勿写入此文件。",
        "SecretKey": "",
        "Issuer": "SwitchYard.Service",
        "Audience": "SwitchYard.Client",
        "ExpirationMinutes": "60",
        "RefreshTokenExpirationDays": "7"
    },
    "HumpDatabase": {
        "_comment": "敏感字段（Username/Password）通过环境变量 HumpDatabase__MysqlConfig__Username / HumpDatabase__MysqlConfig__Password 注入。",
        "DatabaseType": "Mysql",
        "MysqlConfig": {
            "Host": "127.0.0.1",
            "Port": 3306,
            "Database": "hump",
            "Username": "",
            "Password": "",
            "CharSet": "utf8mb4",
            "SslMode": "Preferred",
            "ConnectionTimeout": 15
        },
        "SqlliteConfig": {
            "DatabaseFile": "/root/codes/SwitchYard/hump.db"
        }
    }
}
