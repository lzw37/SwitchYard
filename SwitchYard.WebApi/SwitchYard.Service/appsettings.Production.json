{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
            "Microsoft.AspNetCore.Routing": "Warning"
        },
        "Console": {
            "LogLevel": {
                "Default": "Information",
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "WebApi": {
        "Hosts": ["http://localhost:7297"]
    },
    "Cors": {
        "AllowedOrigins": [
            "https://switchyard.top",
            "http://switchyard.top",
            "https://kapparail.com",
            "https://www.kapparail.com",
            "https://api.kapparail.com",
            "https://api.kapparail.com:8080",
            "http://localhost:4173",
            "https://localhost:4173",
            "http://127.0.0.1:4173"
        ]
    },
    "Course": {
        "VideoDir": "/data/switchyardvid",
        "DocDir": "/data/switchyardvid"
    },
    "Jwt": {
        "SecretKey": "SwitchYard_JWT_Secret_Key_Production_2024_MinLength32Characters_ForSecurity_v1.0",
        "Issuer": "SwitchYard.Service",
        "Audience": "SwitchYard.Client",
        "ExpirationMinutes": "60"
    },
    "HumpDatabase": {
        "DatabaseType": "Sqllite",
        "SqlliteConfig": {
            "DatabaseFile": "/root/codes/SwitchYard/hump.db"
        }
    }
}
