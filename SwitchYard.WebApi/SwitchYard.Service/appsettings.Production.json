{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Microsoft.AspNetCore.Routing": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "WebApi": {
    "_comment": "Host bindings are normally overridden by /etc/switchyard/api.env.",
    "Hosts": [
      "http://127.0.0.1:7297",
      ""
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://switchyard.top",
      "http://switchyard.top",
      "https://kapparail.com",
      "https://www.kapparail.com",
      "https://api.kapparail.com",
      "https://api.kapparail.com:8080",
      "https://202.112.153.154:7070"
    ]
  },
  "Course": {
    "VideoDir": "/data/switchyardvid",
    "DocDir": "/data/switchyardvid"
  },
  "Jwt": {
    "_comment": "SecretKey must be injected through Jwt__SecretKey. Do not store secrets in source control.",
    "SecretKey": "",
    "Issuer": "SwitchYard.Service",
    "Audience": "SwitchYard.Client",
    "ExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  },
  "HumpDatabase": {
    "_comment": "Inject Username and Password through environment variables.",
    "DatabaseType": "Mysql",
    "MysqlConfig": {
      "Host": "127.0.0.1",
      "Port": 3306,
      "Database": "hump",
      "Username": "",
      "Password": "",
      "CharSet": "utf8mb4",
      "SslMode": "Preferred",
      "ConnectionTimeout": 15
    },
    "SqlliteConfig": {
      "DatabaseFile": "/opt/switchyard/data/hump.db"
    }
  }
}
