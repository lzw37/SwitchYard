[Unit]
Description=SwitchYard Web API Service
Documentation=https://github.com/lzw37/SwitchYard
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/switchyard/api/SwitchYard.Service.dll
ConditionPathExists=/etc/switchyard/api.env

[Service]
Type=simple
User=switchyard
Group=switchyard
WorkingDirectory=/opt/switchyard/api
EnvironmentFile=/etc/switchyard/api.env
ExecStart=/usr/bin/dotnet /opt/switchyard/api/SwitchYard.Service.dll
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=switchyard-api
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
ReadWritePaths=/opt/switchyard/api/logs /opt/switchyard/data

[Install]
WantedBy=multi-user.target
