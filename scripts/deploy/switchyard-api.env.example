# =============================================================================
# SwitchYard.Service 生产环境敏感配置 - 环境变量模板
# -----------------------------------------------------------------------------
# 用法：
#   1. 复制为正式文件并填入真实值：
#        sudo cp switchyard-api.env.example /etc/switchyard/api.env
#        sudo chmod 600 /etc/switchyard/api.env
#        sudo chown switchyard:switchyard /etc/switchyard/api.env
#   2. 该文件由 systemd 通过 EnvironmentFile= 加载（见 switchyard-api.service）。
#   3. 切勿提交到 git 仓库。
#
# ASP.NET Core 配置层级映射：双下划线 "__" = JSON 中的冒号 ":"
# 例：HumpDatabase__MysqlConfig__Password 对应 HumpDatabase:MysqlConfig:Password
# =============================================================================

# ---- 运行环境 ----
ASPNETCORE_ENVIRONMENT=Production
# 监听地址（按需改写，systemd 服务会以此启动 Kestrel）
ASPNETCORE_URLS=http://127.0.0.1:7297

# ---- 数据库（MySQL）凭据 ----
HumpDatabase__DatabaseType=Mysql
HumpDatabase__MysqlConfig__Host=127.0.0.1
HumpDatabase__MysqlConfig__Port=3306
HumpDatabase__MysqlConfig__Database=hump
HumpDatabase__MysqlConfig__Username=REPLACE_WITH_DB_USER
HumpDatabase__MysqlConfig__Password=REPLACE_WITH_DB_PASSWORD
HumpDatabase__MysqlConfig__SslMode=Preferred
HumpDatabase__MysqlConfig__CharSet=utf8mb4
HumpDatabase__MysqlConfig__ConnectionTimeout=15

# ---- JWT 签名密钥（至少 32 个字符，建议 64+） ----
# 生成命令：openssl rand -base64 64 | tr -d '\n'
Jwt__SecretKey=REPLACE_WITH_LONG_RANDOM_SECRET
