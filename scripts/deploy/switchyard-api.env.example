# Copy this file to /etc/switchyard/api.env and protect it with mode 0600.
# The systemd unit reads it via EnvironmentFile=/etc/switchyard/api.env.
# ASP.NET Core maps "__" to ":" in configuration keys.

ASPNETCORE_ENVIRONMENT=Production

# Explicitly override the host array so Production does not inherit dev-only listeners.
# Default: bind Kestrel to loopback and place Nginx/Caddy/Apache in front for TLS.
WebApi__Hosts__0=http://127.0.0.1:7297
WebApi__Hosts__1=

# Optional overrides for course assets if they are stored elsewhere.
# Course__VideoDir=/data/switchyardvid
# Course__DocDir=/data/switchyardvid

HumpDatabase__DatabaseType=Mysql
HumpDatabase__MysqlConfig__Host=127.0.0.1
HumpDatabase__MysqlConfig__Port=3306
HumpDatabase__MysqlConfig__Database=hump
HumpDatabase__MysqlConfig__Username=REPLACE_WITH_DB_USER
HumpDatabase__MysqlConfig__Password=REPLACE_WITH_DB_PASSWORD
HumpDatabase__MysqlConfig__SslMode=Preferred
HumpDatabase__MysqlConfig__CharSet=utf8mb4
HumpDatabase__MysqlConfig__ConnectionTimeout=15

CapacityDatabase__DatabaseType=Mysql
CapacityDatabase__MysqlConfig__Host=127.0.0.1
CapacityDatabase__MysqlConfig__Port=3306
CapacityDatabase__MysqlConfig__Database=capacity
CapacityDatabase__MysqlConfig__Username=REPLACE_WITH_DB_USER
CapacityDatabase__MysqlConfig__Password=REPLACE_WITH_DB_PASSWORD
CapacityDatabase__MysqlConfig__SslMode=Preferred
CapacityDatabase__MysqlConfig__CharSet=utf8mb4
CapacityDatabase__MysqlConfig__ConnectionTimeout=15

# Generate with: openssl rand -base64 64 | tr -d '\n'
Jwt__SecretKey=REPLACE_WITH_LONG_RANDOM_SECRET
