# Copy to .env.docker. Always pass: docker compose --env-file .env.docker ...
# This file is an interpolation source; only variables referenced in compose.yaml
# are passed to services. Do not commit the real .env.docker.
COMPOSE_PROJECT_NAME=switchyard
SWITCHYARD_ARCH=amd64
# Image tag only. The API version comes from the original appsettings.json.
SWITCHYARD_IMAGE_TAG=local

# Browsers connect directly to frontend Nginx through this Docker port mapping.
# No Nginx installation on the host is required.
SWITCHYARD_HTTP_BIND=0.0.0.0
SWITCHYARD_HTTP_PORT=8080
# Keep empty to send browser API requests through frontend Nginx to api:8080.
# Changing domains or the published port requires no frontend rebuild.
# A separate API origin must be an absolute http(s) URL, WITHOUT /api.
SWITCHYARD_API_BASE_URL=
# Only needed for a separate frontend/API origin; use the frontend's exact origin.
SWITCHYARD_CORS_ORIGIN=

# Existing MySQL: create all three databases and grant the application account
# schema migration + read/write permissions before starting the API.
# localhost inside the API container is NOT the Docker host.
SWITCHYARD_DB_HOST=host.docker.internal
SWITCHYARD_DB_PORT=3306
SWITCHYARD_DB_USER=switchyard
SWITCHYARD_DB_PASSWORD=''
SWITCHYARD_HUMP_DB=hump
SWITCHYARD_CAPACITY_DB=capacity
SWITCHYARD_SKETCHLAYOUT_DB=sketchlayout
SWITCHYARD_DB_SSL_MODE=Preferred

# Required: generate once (e.g. openssl rand -base64 64), keep across restarts.
# Single quotes protect literal dollar signs from Compose interpolation.
SWITCHYARD_JWT_KEY=''

# Existing readable host directory; mounted read-only. Use forward slashes on
# Windows, e.g. D:/SwitchYard/switchyardvid. Relative paths use the Compose root.
SWITCHYARD_COURSE_PATH=./switchyardvid
