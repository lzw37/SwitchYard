            "tooltip": {
                "pure": "<div class='resistance-formula-title'>基本阻力能高</div><div class='resistance-formula-line'>h<sub>0</sub> = (r<sub>0,溜</sub> · L<sub>溜</sub> + r<sub>0,场</sub> · L<sub>场</sub>) / 1000</div><div class='resistance-formula-line'>r<sub>0</sub> = 2.439 + (0.00008·<b>Q</b> − 0.01743)·<b>t</b> − 0.015·<b>Q</b> + 0.00017·<b>t</b>² + 0.1·<b>v</b> + <b>n</b>·1.65·σ + (1−<b>k</b>)·0.39</div><div class='resistance-formula-line'>σ = 0.602 − (0.0012 + 0.00002·<b>Q</b>)·<b>t</b> − 0.003·<b>Q</b> + 0.00002·<b>t</b>²</div><div class='resistance-formula-params'><b>Q</b> = {Q} t；<b>t</b> = {temp} °C；<b>n</b> = {n}（车型参数）；<b>v<sub>溜</sub></b> = {vSlope} m/s（k=0）；<b>v<sub>场</sub></b> = {vYard} m/s（k=1）；r<sub>0,溜</sub> = {r0Slope} N/kN；r<sub>0,场</sub> = {r0Yard} N/kN；<b>L<sub>溜</sub></b> = {lSlope} m；<b>L<sub>场</sub></b> = {lYard} m</div>",
                "air": "<div class='resistance-formula-title'>风阻力能高</div><div class='resistance-formula-line'>h<sub>w</sub> = (r<sub>w,溜</sub> · L<sub>溜</sub> + r<sub>w,场</sub> · L<sub>场</sub>) / 1000</div><div class='resistance-formula-line'>r<sub>w</sub> = (<b>ρ</b> · <b>f</b> · <b>c<sub>x1</sub>/c<sub>x0</sub></b>) / (2 · <b>Q</b> · cos²<b>α</b>) · (<b>v</b> + ξ · <b>v<sub>风</sub></b> · cos<b>β</b>)²</div><div class='resistance-formula-line'><b>α</b> = arctan((<b>v<sub>风</sub></b> · sin<b>β</b>) / (<b>v</b> + ξ · <b>v<sub>风</sub></b> · cos<b>β</b>))</div><div class='resistance-formula-params'><b>Q</b> = {Q} t；<b>ρ</b> = {rho} kg·s²/m⁴；<b>f</b> = {f} m²；<b>v<sub>风</sub></b> = {vWind} m/s；ξ = {xi}；<b>β</b> = 0°；<b>α</b> = 0°；<b>c<sub>x1</sub>/c<sub>x0</sub></b> = 1；<b>v<sub>溜</sub></b> = {vSlope} m/s；<b>v<sub>场</sub></b> = {vYard} m/s；r<sub>w,溜</sub> = {rwSlope} N/kN；r<sub>w,场</sub> = {rwYard} N/kN；<b>L<sub>溜</sub></b> = {lSlope} m；<b>L<sub>场</sub></b> = {lYard} m</div>",
                "switch": "<div class='resistance-formula-title'>道岔阻力能高</div><div class='resistance-formula-line'>h<sub>s</sub> = E<sub>s</sub> / 1000</div><div class='resistance-formula-line'>E<sub>s</sub> = 24·<b>N<sub>逆</sub></b> + 12·(<b>N<sub>顺</sub></b> + <b>N<sub>菱</sub></b>) + 48·<b>N<sub>交分</sub></b></div><div class='resistance-formula-params'><b>N<sub>逆</sub></b> = {nReverse}；<b>N<sub>顺</sub></b> = {nForward}；<b>N<sub>菱</sub></b> = {nDiamond}；<b>N<sub>交分</sub></b> = {nSlip}；E<sub>s</sub> = {Es} N·m/kN</div>",
                "curve": "<div class='resistance-formula-title'>曲线阻力能高</div><div class='resistance-formula-line'>h<sub>c</sub> = E<sub>c</sub> / 1000</div><div class='resistance-formula-line'>E<sub>c</sub> = 8 · <b>θ<sub>总</sub></b> = 8 · (<b>θ<sub>曲</sub></b> + <b>θ<sub>岔</sub></b>)</div><div class='resistance-formula-params'><b>θ<sub>曲</sub></b> = {pureCurve} °（曲线转角）；<b>θ<sub>岔</sub></b> = {switchCurve} °（道岔转角）；<b>θ<sub>总</sub></b> = {totalCurve} °；E<sub>c</sub> = {Ec} N·m/kN</div>"
            },
