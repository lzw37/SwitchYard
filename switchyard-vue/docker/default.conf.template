map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 25m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vue pages share controller prefixes with the API. Keep these complete page
    # paths before the API regex (Nginx uses the first matching regex location).
    # Optional trailing slashes and casing match Vue Router's default behavior.
    location ~* ^/(hump(?:/instancemanagement)?|capacity|sketchlayout)/?$ {
        try_files /index.html =404;
        add_header Cache-Control "no-store" always;
    }

    # ASP.NET Core accepts case-insensitive routes; existing clients also use
    # /hump/getflatlayout. Preserve action paths and query strings for every case.
    location ~* ^/(api|hubs|Course|Capacity|Hump|StationLayout|OperationPlan|OperationProcess|SketchLayout)(/|$) {
        # Resolve again after API container replacement instead of retaining its old IP.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $switchyard_backend "${SWITCHYARD_BACKEND_URL}";
        proxy_pass $switchyard_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # This container is the public HTTP entrypoint, so forward its observed
        # client address/protocol instead of accepting client-supplied proxy headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # ASP.NET serves course videos/files with range processing enabled.
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /runtime-config.js {
        try_files $uri =404;
        etag off;
        if_modified_since off;
        add_header Cache-Control "no-store" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    # Vue Router uses browser history; direct navigation and refresh need this fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
